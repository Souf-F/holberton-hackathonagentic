# Copier ce fichier en .env et remplir les valeurs.
# Le .env n'est JAMAIS commite (voir .gitignore).

# --- Modele ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Integration externe reelle ---
# Token a portee minimale : creation d'issues sur UN seul depot.
GITHUB_TOKEN=
GITHUB_REPO=Souf-F/holberton-hackathonagentic

# --- Stockage local ---
DATABASE_PATH=./data/pennyworth.db

# --- Effets de bord locaux assumes (voir SPEC.md) ---
# Messagerie locale : send_message ecrit un .eml ici au lieu d'envoyer.
OUTBOX_DIR=./outbox
# Fichiers generes : livrets d'accueil, evenements .ics.
ARTIFACTS_DIR=./artifacts

# --- Serveur ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Durcissement optionnel (voir SECURITE.md) ---
# Laisser vide = comportement actuel inchange (aucune authentification).
# Si rempli, toutes les routes /api/... exigent l'en-tete
# "X-Access-Token: <valeur>". Le front (web/) ne l'envoie pas encore : a
# ne remplir que si le front est mis a jour en consequence.
APP_ACCESS_TOKEN=
